{
  "id": "elecrow_crowpanel_advanced_9_p4",
  "displayName": "Elecrow CrowPanel Advanced 9\" (ESP32-P4)",
  "family": "espressif",
  "framework": "espidf",
  "frameworkOptions": {
    "idfTarget": "esp32p4",
    "mcuChip": "esp32p4",
    "cpuFreqHz": 360000000,
    "flashSize": 16777216,
    "sdkconfig": [
      "CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y",
      "CONFIG_ESP32P4_REV_MIN_100=y",
      "CONFIG_CACHE_L2_CACHE_256KB=y",
      "CONFIG_CACHE_L2_CACHE_LINE_128B=y"
    ],
    "wifiCoprocessor": "esp32c6",
    "wifiCoprocessorSdkconfig": [
      "CONFIG_ESP_HOSTED_SDIO_SLOT_1=y",
      "CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y",
      "CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=17",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=16",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=15",
      "CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=14",
      "CONFIG_ESP_HOSTED_HOST_RESET_GPIO=32"
    ]
  },
  "externalMemorySize": 33554432,
  "screenWidth": 1024,
  "screenHeight": 600,
  "screenDiagonalInches": 9.0,
  "colorFormat": "RGB565",
  "provides": [
    "filesystem",
    "threads",
    "psram",
    "spi",
    "i2c",
    "wifi"
  ],
  "requiresPackages": [
    "deki-esp32-integration",
    "deki-display"
  ],
  "defines": [
    "ESP32"
  ],
  "bootScene": "platforms/elecrow_crowpanel_advanced_9_p4/boot.scene"
}
